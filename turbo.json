{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "FINNHUB_API_KEY",
    "NODE_ENV",
    "TZ",
    "CI",
    "MONITOR",
    "LOG_LEVEL",
    "FREEZE_DATE",
    "TIINGO_API_KEY",
    "PRICE_STRICT",
    "RT_CLOSE_WINDOW_MIN",
    "CLOSE_GRACE_MIN",
    "API_RATE_LIMIT",
    "API_REQUESTS_PER_MIN",
    "READ_PUBLIC_MODE",
    "PUBLIC_DATA_BASE",
    "SAFE_PRICE_MODE",
    "NEXT_PUBLIC_FREEZE_DATE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "SAFE_PRICE_MODE",
        "NEXT_PUBLIC_FREEZE_DATE"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "env": [
        "SAFE_PRICE_MODE",
        "NEXT_PUBLIC_FREEZE_DATE"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

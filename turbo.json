{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "FINNHUB_API_KEY",
    "NODE_ENV",
    "TZ",
    "CI",
    "MONITOR",
    "LOG_LEVEL",
    "FREEZE_DATE",
    "TIINGO_API_KEY",
    "PRICE_STRICT",
    "RT_CLOSE_WINDOW_MIN",
    "CLOSE_GRACE_MIN",
    "API_RATE_LIMIT",
    "API_REQUESTS_PER_MIN",
    "READ_PUBLIC_MODE",
    "PUBLIC_DATA_BASE",
    "SAFE_PRICE_MODE",
    "NEXT_PUBLIC_FREEZE_DATE",
    "WRITEBACK_MODE",
    "NEXT_PUBLIC_WRITEBACK_MODE",
    "NEXT_PUBLIC_BASE_PATH",
    "NEXT_PUBLIC_ASSET_PREFIX",
    "OFFICIAL_CLOSE_FIX_ENABLED",
    "NEXT_PUBLIC_OFFICIAL_CLOSE_FIX_ENABLED",
    "__NEXT_ROUTER_BASEPATH",
    "__NEXT_ASSET_PREFIX",
    "BASE_PATH",
    "ASSET_PREFIX",
    "DIAG_PRICE_READY_TRACE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "SAFE_PRICE_MODE",
        "NEXT_PUBLIC_FREEZE_DATE",
        "WRITEBACK_MODE",
        "NEXT_PUBLIC_WRITEBACK_MODE",
        "NEXT_PUBLIC_BASE_PATH",
        "NEXT_PUBLIC_ASSET_PREFIX",
        "OFFICIAL_CLOSE_FIX_ENABLED",
        "NEXT_PUBLIC_OFFICIAL_CLOSE_FIX_ENABLED",
        "__NEXT_ROUTER_BASEPATH",
        "__NEXT_ASSET_PREFIX",
        "BASE_PATH",
        "ASSET_PREFIX",
        "DIAG_PRICE_READY_TRACE"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "env": [
        "SAFE_PRICE_MODE",
        "NEXT_PUBLIC_FREEZE_DATE",
        "WRITEBACK_MODE",
        "NEXT_PUBLIC_WRITEBACK_MODE",
        "NEXT_PUBLIC_BASE_PATH",
        "NEXT_PUBLIC_ASSET_PREFIX",
        "OFFICIAL_CLOSE_FIX_ENABLED",
        "NEXT_PUBLIC_OFFICIAL_CLOSE_FIX_ENABLED",
        "__NEXT_ROUTER_BASEPATH",
        "__NEXT_ASSET_PREFIX",
        "BASE_PATH",
        "ASSET_PREFIX",
        "DIAG_PRICE_READY_TRACE"
      ]
    },
    "lint:official-close": {
      "dependsOn": [
        "^lint:official-close"
      ],
      "env": [
        "SAFE_PRICE_MODE",
        "NEXT_PUBLIC_FREEZE_DATE",
        "WRITEBACK_MODE",
        "NEXT_PUBLIC_WRITEBACK_MODE",
        "NEXT_PUBLIC_BASE_PATH",
        "NEXT_PUBLIC_ASSET_PREFIX",
        "OFFICIAL_CLOSE_FIX_ENABLED",
        "NEXT_PUBLIC_OFFICIAL_CLOSE_FIX_ENABLED",
        "__NEXT_ROUTER_BASEPATH",
        "__NEXT_ASSET_PREFIX",
        "BASE_PATH",
        "ASSET_PREFIX",
        "DIAG_PRICE_READY_TRACE"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "typecheck:official-close": {
      "dependsOn": [
        "^typecheck:official-close"
      ]
    },
    "test:official-close": {
      "dependsOn": [
        "^test:official-close"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

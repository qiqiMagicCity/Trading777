# API Keys for stock data providers
VITE_FINNHUB_KEY=your_finnhub_api_key_here
VITE_ALPHA_VANTAGE_KEY=your_alphavantage_api_key_here
# For Next.js exposure to browser use NEXT_PUBLIC_ prefix
NEXT_PUBLIC_FINNHUB_TOKEN=${VITE_FINNHUB_KEY}
NEXT_PUBLIC_ALPHA_VANTAGE_TOKEN=${VITE_ALPHA_VANTAGE_KEY}
NEXT_PUBLIC_TIINGO_TOKEN=your_tiingo_api_key_here
# Server-side Finnhub API key. Define only on the server and never expose to the browser
FINNHUB_API_KEY=

# Optional: Analytics (if used)
NEXT_PUBLIC_ANALYTICS_ID=

# Vercel specific settings (handled automatically in Vercel deployments)
VERCEL_URL=
VERCEL_ENV=production

# Application settings
# Optional: freeze all price lookups to a specific trading day (YYYY-MM-DD)
NEXT_PUBLIC_FREEZE_DATE=
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Optional: endpoint to receive monitoring alerts
NEXT_PUBLIC_MONITOR_URL=
# 视觉态强制（仅影响外观，不改真实 data-state）
# NEXT_PUBLIC_FORCE_BADGE_VISUAL=live

# 绕过系统“减少动效”，强制使用 animate-*
# NEXT_PUBLIC_FORCE_BADGE_MOTION=1
# Minutes after NY 16:00 where realtime quote is treated as the official close (default 180)
RT_CLOSE_WINDOW_MIN=180
NODE_ENV=production
# === Badge Diagnostics & Motion Overrides ===
# 强制动效：1=强制开启 animate-*（忽略用户“减少动态”）
# 不设置或设为 0 表示按 RESPECT_REDUCED_MOTION 决定
NEXT_PUBLIC_FORCE_BADGE_MOTION=0

# 强制视觉：1=无论数据状态如何，都按 live 配色与动画显示（排障利器）
NEXT_PUBLIC_FORCE_BADGE_VISUAL=0

# 是否尊重“减少动态”系统偏好：1=尊重，0/未设=不尊重（默认不尊重以保证可见）
NEXT_PUBLIC_RESPECT_REDUCED_MOTION=0

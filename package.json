{
  "name": "trading-app",
  "private": true,
  "scripts": {
    "build": "npx --yes turbo run build",
    "dev": "npx --yes turbo run dev",
    "lint": "npx --yes turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "npx --yes turbo run check-types",
    "test": "npx --yes jest",
    "test:periods-core": "npm test -- --runInBand apps/web/app/lib/__tests__/metrics-wtd-mtd-ytd.test.ts apps/web/app/lib/__tests__/metrics-integration-wtd-mtd-ytd.from-calcMetricsInternal.test.ts apps/web/app/lib/__tests__/metrics-integration-wtd-mtd-ytd.filter.test.ts apps/web/app/lib/__tests__/metrics-ny-date-normalization.test.ts apps/web/app/lib/__tests__/metrics-today-counts.test.ts",
    "test:m6-ui": "npm test -- --runInBand apps/web/app/modules/__tests__/DashboardMetrics.test.tsx apps/web/app/modules/__tests__/positionMetrics.test.ts",
    "verify:golden": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/verify-golden.ts",
    "check:conflicts": "node scripts/check-conflicts.mjs",
    "check:calcmetrics-daily": "node scripts/check-calcmetrics-daily.mjs",
    "snapshot:daily": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/snapshot.ts",
    "verify:history": "tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/verify-history.ts",
    "ci:pr": "npm run check:conflicts && npm run check:calcmetrics-daily && npm run verify:golden && turbo run build --filter=!web --output-logs=errors-only",
    "check:types": "tsc -p apps/web/tsconfig.json --noEmit",
    "ci": "npm run check:calcmetrics-daily && npm run check:types -w web && npm run test -w web && npm run build -w web",
    "guard": "npm run ci",
    "selfcheck:j:sticky": "jest apps/web/app/lib/__tests__/breakevenJ.sticky.test.ts apps/web/app/modules/__tests__/PositionsTable.breakevenJ.test.tsx",
    "selfcheck:m4": "jest apps/web/app/lib/__tests__/m4.selfcheck.test.ts --runInBand",
    "test:m4:fix": "jest apps/web/app/lib/__tests__/m4.selfcheck.test.ts --runInBand",
    "test:m4:ui": "jest apps/web/app/modules/__tests__/m4.ui.align.test.tsx --runInBand",
    "test:m4:edge": "jest apps/web/app/lib/__tests__/m4.edgecases.test.ts --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "fake-indexeddb": "^6.0.1",
    "fast-check": "^4.3.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "tsx": "^4.19.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "date-fns-tz": "^3.2.0",
    "turbo": "^2.5.4"
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals"
    ]
  }
}
